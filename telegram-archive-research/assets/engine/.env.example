# Get these from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Optional default dialog.
TG_CHAT=

# Optional proxy. Leave all fields empty for a direct connection.
TG_PROXY_TYPE=
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=
TG_PROXY_USER=
TG_PROXY_PASSWORD=

# Transcription settings. Model choices: tiny, base, small, medium, large-v3.
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
